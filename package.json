{
  "name": "reporteador-empresas",
  "version": "1.0.0",
  "description": "Sistema para procesar texto e imágenes y generar reportes Word con formato estándar para diferentes empresas",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "build": "npm run clean && npm run build:prod",
    "clean": "rimraf dist",
    "build:prod": "webpack --mode production",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js"
  },
  "keywords": [
    "docx",
    "word",
    "report",
    "generator",
    "javascript",
    "nodejs"
  ],
  "author": "Tu Nombre",
  "license": "MIT",
  "dependencies": {
    "docx": "^8.5.0",
    "mammoth": "^1.6.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "fs-extra": "^11.2.0",
    "path": "^0.12.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
